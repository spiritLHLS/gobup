# GoBup 环境变量配置示例
# 复制此文件为 .env 并修改相应的值

# ===== 认证配置 =====
# 管理员用户名（推荐设置，仅首次启动时创建管理员账户）
GOBUP_USERNAME=admin

# 管理员密码（推荐设置，仅首次启动时创建管理员账户）
# 注意：请使用强密码，建议包含大小写字母、数字和特殊字符
GOBUP_PASSWORD=your_secure_password_here

# ===== Docker 部署配置 =====
# 对于 Docker 部署，使用以下变量名
# USERNAME=admin
# PASSWORD=your_secure_password_here

# ===== 其他配置 =====
# 时区设置（可选，默认 Asia/Shanghai）
TZ=Asia/Shanghai

# 录制文件工作目录（裸机运行可通过 -work-path 或 WORK_PATH 指定；Docker 默认挂载到 /rec）
WORK_PATH=/rec

# 上传请求超时（可选，默认 30 分钟，最大 1440 分钟）
GOBUP_UPLOAD_TIMEOUT_MINUTES=30

# TLS 握手超时（可选，默认 30 秒，最大 300 秒）
GOBUP_TLS_HANDSHAKE_TIMEOUT_SECONDS=30

# B 站 TV 二维码登录和 refresh_token 刷新签名配置（可选；不配置时相关功能不可用）
# BILI_APP_KEY=replace_with_bilibili_app_key
# BILI_APP_SECRET=replace_with_bilibili_app_secret

# WebSocket 跨源白名单（可选，默认仅允许同源；多个 Origin 用英文逗号分隔，不支持 *）
# GOBUP_ALLOWED_ORIGINS=https://panel.example.com

# Rust Agent 配置（由 scripts/install_agent.sh 写入 /opt/gobup/agent/env；手动运行时可直接使用）
# GOBUP_AGENT_TOKEN=replace_with_agent_token
# GOBUP_AGENT_PURPOSE=both
# GOBUP_AGENT_LISTEN=0.0.0.0:12381
# GOBUP_AGENT_WORK_PATH=/rec
# GOBUP_AGENT_UPSTREAM_BASE_URL=https://panel.example.com
# GOBUP_AGENT_UPSTREAM_TOKEN=replace_with_agent_token

# DanmakuFactory 与字体配置（可选，启用弹幕烧录时使用）
DANMAKU_FACTORY_PATH=/usr/local/bin/danmakufactory/DanmakuFactory
DANMAKU_FONT_NAME="WenQuanYi Zen Hei"
DANMAKU_FONTS_DIR=/usr/share/fonts

# ===== 安装版本 =====
# 指定安装的版本（可选，默认为最新版本）
# INSTALL_VERSION=v20250101-120000

# ===== 使用说明 =====
# 1. 安装脚本部署：
#    GOBUP_USERNAME=admin GOBUP_PASSWORD='replace_with_a_long_random_password' bash install.sh
#
# 2. Docker 部署：
#    docker run -d \
#      -e USERNAME=admin \
#      -e PASSWORD=replace_with_a_long_random_password \
#      -p 22380:12380 \
#      -v ./recordings:/rec \
#      -v ./data:/app/data \
#      -e DANMAKU_FACTORY_PATH=/usr/local/bin/danmakufactory/DanmakuFactory \
#      spiritlhl/gobup:latest
#
# 3. Docker Compose 部署：
#    在 docker-compose.yml 中设置环境变量或使用 .env 文件
#
# 4. 手动运行：
#    ./gobup-server -username admin -password 'replace_with_a_long_random_password' -port 12380 -work-path /path/to/recordings

# ===== 安全提示 =====
# - 请勿将包含真实密码的 .env 文件提交到版本控制系统
# - 建议使用强密码（至少12位，包含大小写字母、数字和特殊字符）
# - 定期备份数据库文件 ./data/gobup.db
# - 如需修改密码，需删除数据库重新初始化
